---
// Mosaic grid: tiles get different sizes from a repeating 12-tile pattern.
---
<div class="grid">
  <slot />
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(10rem, 17vw, 15rem);
    grid-auto-flow: dense;
    gap: 12px;
  }

  /*
    Each block of 6 tiles fills 4 columns x 3 rows exactly; the second block
    mirrors the first so the big tile alternates sides.
      block A: big | small | tall / small / wide | wide
      block B: tall | small | big / small / wide | wide
  */
  .grid > :global(:nth-child(12n + 1)) { grid-column: span 2; grid-row: span 2; }
  .grid > :global(:nth-child(12n + 3)) { grid-row: span 2; }
  .grid > :global(:nth-child(12n + 5)),
  .grid > :global(:nth-child(12n + 6)) { grid-column: span 2; }

  .grid > :global(:nth-child(12n + 7)) { grid-row: span 2; }
  .grid > :global(:nth-child(12n + 9)) { grid-column: span 2; grid-row: span 2; }
  .grid > :global(:nth-child(12n + 11)),
  .grid > :global(:nth-child(12n + 12)) { grid-column: span 2; }

  /* When the list ends mid-block, stretch the last tiles so no holes remain. */
  @media (min-width: 901px) {
    .grid > :global(:nth-child(12n + 1):last-child),
    .grid > :global(:nth-child(12n + 5):last-child),
    .grid > :global(:nth-child(12n + 7):last-child),
    .grid > :global(:nth-child(12n + 11):last-child) { grid-column: 1 / -1; }
    .grid > :global(:nth-child(12n + 2):last-child) { grid-column: span 2; grid-row: span 2; }
    .grid > :global(:nth-child(12n + 2):nth-last-child(2)),
    .grid > :global(:nth-child(12n + 8):nth-last-child(2)) { grid-row: span 2; }
    .grid > :global(:nth-child(12n + 8):last-child) { grid-column: span 3; grid-row: span 2; }
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: clamp(9rem, 30vw, 14rem);
    }
  }
  @media (max-width: 680px) {
    .grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: 16px;
    }
    .grid > :global(*) { grid-column: auto !important; grid-row: auto !important; }
  }
</style>
