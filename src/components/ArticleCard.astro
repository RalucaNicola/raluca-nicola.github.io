---
import { type Section } from '~/utils/site';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  cover?: string;
  coverAlt?: string;
  section?: Section;
  tags?: string[];
}

const { href, title, description, date, cover, coverAlt, section, tags = [] } = Astro.props;
// Work tiles show only the title and description; the date and tags are omitted.
const showMeta = section !== 'work';
const dateLabel = date.toLocaleDateString('en-US', { year: '2-digit', month: 'short' });
const category = tags.join(' · ');
const base = import.meta.env.BASE_URL;
const coverSrc = cover
  ? (cover.startsWith('http') ? cover : (base + cover).replace(/\/+/g, '/'))
  : undefined;
---

<a class="item" href={href} aria-label={title}>
  {coverSrc ? (
    <img class="layer" src={coverSrc} alt={coverAlt ?? ''} loading="lazy" decoding="async" />
  ) : (
    <div class="layer cover-fallback" aria-hidden="true">{tags[0] ?? ''}</div>
  )}
  <div class="overlay">
    {showMeta && (
      <div class="meta">
        <time datetime={date.toISOString()}>{dateLabel}</time>
        {category && <span> · {category}</span>}
      </div>
    )}
    <h3>{title}</h3>
    <p class="desc">{description}</p>
  </div>
</a>

<style>
  .item {
    display: block;
    position: relative;
    height: 100%;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--accent-soft);
  }
  .item:hover { text-decoration: none; }

  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      filter 0.5s ease,
      transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1);
    transform: scale(1.01);
  }

  .cover-fallback {
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    color: var(--accent);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
  }

  /* title and description stay hidden until the tile is hovered or focused */
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 18px 20px;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.15) 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .item:hover .overlay,
  .item:focus-visible .overlay { opacity: 1; }
  .item:hover .layer,
  .item:focus-visible .layer {
    filter: grayscale(1);
    transform: scale(1.04);
  }

  .meta {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
    color: #fff;
  }
  .desc {
    font-size: 0.875rem;
    line-height: 1.45;
    margin: 0;
    max-width: 440px;
    opacity: 0.9;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* touch screens can't hover: keep the title visible, in colour */
  @media (hover: none) {
    .overlay { opacity: 1; }
    .item:hover .layer { filter: none; }
  }
  @media (max-width: 680px) {
    .item { aspect-ratio: 4 / 3; height: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .layer, .overlay { transition: none; }
  }
</style>
